{
  "schema_version": "first_slice_viability.v1",
  "minimum_score": 0,
  "materializable_parameter_attributes": [
    "append", "casefold", "decode", "encode", "endswith", "format", "get",
    "items", "join", "keys", "lower", "lstrip", "partition", "removeprefix",
    "removesuffix", "replace", "rsplit", "rstrip", "split", "startswith",
    "strip", "upper", "values"
  ],
  "rules": [
    {
      "rule_id": "bounded_transform_boundary",
      "score_delta": 45,
      "match": {
        "symbol_contains_any": ["parse", "normalize", "validate", "convert", "decode", "encode", "extract", "format", "resolve", "scan", "transform", "truncate"]
      },
      "reason": "bounded parser/normalizer/validator boundary is preferred for a first executable slice"
    },
    {
      "rule_id": "read_or_mapping_boundary",
      "score_delta": 24,
      "match": {
        "symbol_contains_any": ["load", "read", "list", "get_", "to_vec", "from_hex", "output_to"]
      },
      "reason": "read/mapping boundary usually permits fixture-backed execution"
    },
    {
      "rule_id": "instance_method_receiver",
      "score_delta": -45,
      "reselection_required": true,
      "match": {
        "target_binding_in": ["method_symbol", "ambiguous_method_symbol"],
        "snippet_text_contains_any": ["self."]
      },
      "reason": "method reads receiver state and requires an explicit receiver fixture before executable handoff"
    },
    {
      "rule_id": "static_method_boundary",
      "score_delta": 15,
      "match": {
        "target_binding_in": ["method_symbol", "ambiguous_method_symbol"],
        "decorators_contains_any": ["staticmethod", "classmethod"]
      },
      "reason": "static or class method exposes an explicit receiver-independent boundary"
    },
    {
      "rule_id": "runtime_lifecycle_boundary",
      "score_delta": -70,
      "reselection_required": true,
      "match": {
        "symbol_in": ["execute", "launch", "retry", "_kill_process", "kill_process", "shutdown", "terminate"]
      },
      "reason": "runtime lifecycle entrypoint requires environment orchestration rather than first-slice execution"
    },
    {
      "rule_id": "runtime_decorator_factory",
      "score_delta": -70,
      "reselection_required": true,
      "match": {
        "calls_contains_any": ["asyncio.create_task", "background_tasks.add", "add_done_callback"]
      },
      "reason": "runtime task scheduling requires an event-loop fixture rather than a first executable slice"
    },
    {
      "rule_id": "runtime_resource_boundary",
      "score_delta": -70,
      "reselection_required": true,
      "match": {
        "symbol_contains_any": ["create_connection", "handler", "pretrained", "train_model"]
      },
      "reason": "resource, training, or dispatch boundary has high execution cost and requires a cheaper contract slice"
    },
    {
      "rule_id": "dynamic_backend_selector",
      "score_delta": -60,
      "reselection_required": true,
      "match": {
        "calls_contains_any": ["importlib.import_module", "import_module"]
      },
      "reason": "dynamic optional-backend selection depends on installed runtime providers and requires a provider-independent slice"
    },
    {
      "rule_id": "cli_runtime_boundary",
      "score_delta": -50,
      "reselection_required": true,
      "match": {
        "path_contains_any": ["/cli/", "/commands/"]
      },
      "reason": "CLI command surface depends on process configuration and is deferred behind reusable core logic"
    },
    {
      "rule_id": "unmaterialized_object_protocol_input",
      "score_delta": -70,
      "reselection_required": true,
      "match": {
        "input_complexity_in": ["object_protocol"]
      },
      "reason": "input requires an unknown object protocol and must be replaced or explicitly fixture-bound before executable handoff"
    },
    {
      "rule_id": "stateful_method_effects",
      "score_delta": -45,
      "reselection_required": true,
      "match": {
        "target_binding_in": ["method_symbol", "ambiguous_method_symbol"],
        "side_effects_contains_any": ["memory_state", "filesystem", "network", "subprocess"]
      },
      "reason": "stateful method effects require a fixture or process boundary before executable handoff"
    },
    {
      "rule_id": "stateful_runtime_function",
      "score_delta": -55,
      "reselection_required": true,
      "match": {
        "symbol_contains_any": ["fill_buffer", "load_batch", "load_rows"],
        "side_effects_contains_any": ["memory_state"]
      },
      "reason": "stateful data-loading lifecycle requires an explicit state fixture before executable handoff"
    },
    {
      "rule_id": "utility_path_boundary",
      "score_delta": 16,
      "match": {
        "path_contains_any": ["/utils/", "/common/", "/modules_common/", "/parsers/", "/converters/"]
      },
      "reason": "support module exposes a smaller reusable boundary"
    },
    {
      "rule_id": "runtime_callback_boundary",
      "score_delta": -55,
      "reselection_required": true,
      "match": {
        "symbol_contains_any": ["_cb", "callback"]
      },
      "reason": "callback requires an event or runtime fixture before executable handoff"
    },
    {
      "rule_id": "private_runtime_hook",
      "score_delta": -55,
      "reselection_required": true,
      "match": {
        "symbol_contains_any": ["_hook", "hook_", "run_with_reloader"]
      },
      "reason": "private hook or reload-loop callback requires runtime orchestration rather than a first contract slice"
    },
    {
      "rule_id": "external_effect_boundary",
      "score_delta": -65,
      "reselection_required": true,
      "match": {
        "side_effects_contains_any": ["network", "subprocess"]
      },
      "reason": "network or subprocess effect requires an adapter fixture and is deferred behind a pure contract"
    },
    {
      "rule_id": "ml_training_lifecycle",
      "score_delta": -70,
      "reselection_required": true,
      "match": {
        "symbol_in": ["fit", "forward", "predict", "train", "train_batch", "train_model", "visualise"]
      },
      "reason": "model lifecycle requires framework state and is deferred behind a bounded data/shape contract"
    },
    {
      "rule_id": "dataset_generation_lifecycle",
      "score_delta": -45,
      "reselection_required": true,
      "match": {
        "symbol_contains_any": ["gen_dataset", "gen_instance", "gen_rand_graph", "generate_machine", "training_data"]
      },
      "reason": "dataset generation lifecycle is deferred behind a deterministic mapping boundary"
    },
    {
      "rule_id": "gui_lifecycle",
      "score_delta": -80,
      "reselection_required": true,
      "match": {
        "path_contains_any": ["/modules_gui/", "/start_gui.py", "/gui_"]
      },
      "reason": "GUI lifecycle depends on stateful widgets and is not a stable first executable slice"
    },
    {
      "rule_id": "native_ffi_adapter",
      "score_delta": -60,
      "reselection_required": true,
      "match": {
        "path_contains_any": ["/bindings/python_cffi/", "/cffi/", "/ctypes/"]
      },
      "reason": "native FFI adapter requires a separate extension-boundary execution profile"
    },
    {
      "rule_id": "persistence_mutation",
      "score_delta": -55,
      "match": {
        "path_contains_any": ["/services.py", "/models.py", "/repository", "/repositories/"],
        "symbol_contains_any": ["create", "delete", "register", "save", "update"]
      },
      "reason": "persistence mutation is deferred until a read/validation contract is executable"
    },
    {
      "rule_id": "persistence_adapter_state",
      "score_delta": -30,
      "match": {
        "path_contains_any": ["/services.py", "/models.py", "/repository", "/repositories/"]
      },
      "reason": "stateful persistence adapter is lower priority than a transport-independent contract"
    },
    {
      "rule_id": "stateful_constructor_or_dunder",
      "score_delta": -80,
      "reselection_required": true,
      "match": {
        "symbol_in": ["__call__", "__getattr__", "__getstate__", "__init__", "apply"]
      },
      "reason": "stateful constructor or protocol method is context rather than the first writable contract"
    },
    {
      "rule_id": "filesystem_argument_coercion",
      "score_delta": -55,
      "match": {
        "symbol_in": ["filepath", "path"]
      },
      "reason": "filesystem argument coercion is side-effect support, not a representative first slice"
    },
    {
      "rule_id": "test_callable",
      "score_delta": -80,
      "match": {
        "symbol_contains_any": ["test_"]
      },
      "reason": "test callable is verification context rather than a writable project boundary"
    },
    {
      "rule_id": "context_only_tree",
      "score_delta": -40,
      "match": {
        "path_contains_any": ["/examples/", "/scripts/", "/test/", "/tests/"]
      },
      "reason": "example, script, or test tree is context-only when active core candidates exist"
    },
    {
      "rule_id": "vendored_tooling_tree",
      "score_delta": -80,
      "reselection_required": true,
      "match": {
        "path_contains_any": ["/ext_tools/", "/third_party/", "/_vendor/", "/vendor/", "/vendored/"]
      },
      "reason": "vendored or external tooling is context rather than a project-owned first writable slice"
    },
    {
      "rule_id": "unready_dependency_boundary",
      "score_delta": -30,
      "match": {
        "dependency_status_in": ["missing_external", "source_context_required"]
      },
      "reason": "unresolved dependency boundary is lower priority than an environment-ready callable"
    }
  ]
}
