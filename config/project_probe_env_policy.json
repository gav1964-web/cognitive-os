    "yfinance"
  ],
  "native_or_compiled": [
    "bcrypt",
    "httptools",
    "libsass",
    "lxml",
    "matplotlib",
    "msgspec",
    "multidict",
    "numpy",
    "pycurl",
    "pyyaml",
    "scipy",
    "ujson"
  ],
  "wheel_only_native_allowlist": [
    "httptools",
    "libsass",
    "lxml",
    "matplotlib",
    "msgspec",
    "multidict",
    "numpy",
    "pyyaml",
    "scipy",
    "ujson"
  ],
  "package_companions": {
    "sanic-ext": [
      "pydantic"
    ]
  },
  "low_risk_allowlist": [
    "aiofiles",
    "aiohttp",
    "amqp",
    "astroid",
    "atpublic",
    "attrs",
    "boltons",
    "botocore",
    "click",
    "cssselect",
    "docstring-parser",
    "execnet",
    "face",
    "fastapi",
    "filelock",
    "flask",
    "html5tagger",
    "httpx",
    "invoke",
    "jmespath",
    "kombu",
    "loguru",
    "mako",
    "mistune",
    "mypy-extensions",
    "packaging",
    "pathspec",
    "platformdirs",
    "public",
    "pydantic",
    "pydantic-settings",
    "pygments",
    "pyproject-hooks",
    "pytest",
    "python-discovery",
    "python-frontmatter",
    "python-multipart",
    "rich",
    "sanic-ext",
    "sanic-routing",
    "sanic-testing",
    "shellingham",
    "sqlalchemy",
    "stevedore",
    "tomli",
    "tracerite",
    "typing-extensions",
    "urwid",
    "userpath",
    "uvicorn",
    "w3lib",
    "websockets"
  ],
  "internal_probe_stubs": [
    "static_http_route_fallback",
    "static_shape_fallback"
  ],
  "isolated_dependency_profile": {
    "environment_kind": "venv",
    "env_path_template": "artifacts/dependency_envs/{project}/{target_hash}",
    "automatic_install_allowed": false,
    "approval_artifact_type": "DependencyProbeApproval",
    "approval_status": "approved",
    "approval_scope": "isolated_dependency_import_probe",
    "allowed_authorities": ["human", "reviewer"],
    "require_exact_package_set": true,
    "install_timeout_seconds": 240,
    "import_timeout_seconds": 60,
    "prefer_binary": true,
    "verification_gates": [
      "dependency_is_declared_by_project",
      "package_mapping_is_source_proven",
      "environment_is_outside_source_project",
      "import_probe_passes_before_callable_acceptance",
      "source_project_remains_unchanged"
    ],
    "forbidden_actions": [
      "install_into_host_environment",
      "mutate_project_manifest",
      "install_undeclared_package",
      "treat_successful_import_as_semantic_acceptance"
    ]
  }
}
