{
  "schema_version": "self_improvement_plugins.v1",
  "plugins": [
    {
      "id": "config_mutation",
      "version": "1.0.0",
      "enabled": true,
      "priority": 10,
      "entrypoint": "runtime.improvement_plugins.config_mutation:run",
      "change_types": ["config_mutation_proposal"],
      "auto_promote": true,
      "requires_regression_cases": true
    },
    {
      "id": "semantic_profile_admission",
      "version": "1.0.0",
      "enabled": true,
      "priority": 20,
      "entrypoint": "runtime.improvement_plugins.semantic_profile_admission:run",
      "change_types": ["semantic_contract_profile_template"],
      "implements_capabilities": ["semantic_contract_profile_synthesis"],
      "auto_promote": true,
      "requires_regression_cases": false,
      "minimum_confirmed_cases": 3
    },
    {
      "id": "candidate_selection_discriminator",
      "version": "1.3.0",
      "enabled": true,
      "priority": 25,
      "entrypoint": "runtime.improvement_plugins.candidate_selection_discriminator:run",
      "change_types": ["foundation_selection_contrast"],
      "implements_capabilities": [
        "candidate_selection_discriminator_plugin",
        "bounded_executable_target_discovery_or_sandbox_adapter"
      ],
      "failure_classes": [
        "executable_sample_contract",
        "first_slice_reselection_required",
        "side_effectful_target"
      ],
      "auto_promote": false,
      "requires_regression_cases": false,
      "maximum_shadow_challengers": 4,
      "minimum_emergent_confirmations": 3,
      "minimum_shadow_prior_support": 2
    },
    {
      "id": "candidate_selection_admission",
      "version": "1.2.0",
      "enabled": true,
      "priority": 30,
      "entrypoint": "runtime.improvement_plugins.candidate_selection_admission:run",
      "change_types": ["foundation_selection_contrast"],
      "implements_capabilities": ["candidate_selection_structural_discriminator_synthesis"],
      "auto_promote": true,
      "requires_regression_cases": true,
      "minimum_confirmed_cases": 3,
      "maximum_reproduction_refinements": 4,
      "regression_verification_repetitions": 3,
      "regression_case_timeout_seconds": 60,
      "regression_total_timeout_seconds": 480
    },
    {
      "id": "executable_adapter_admission",
      "version": "1.0.0",
      "enabled": true,
      "priority": 40,
      "entrypoint": "runtime.improvement_plugins.executable_adapter_admission:run",
      "change_types": ["foundation_capability_gap"],
      "auto_promote": false,
      "requires_regression_cases": false,
      "minimum_confirmed_cases": 3
    },
    {
      "id": "bounded_parameter_strategy",
      "version": "1.2.0",
      "enabled": true,
      "priority": 50,
      "entrypoint": "runtime.improvement_plugins.bounded_parameter_strategy:run",
      "change_types": ["bounded_parameter_strategy"],
      "implements_capabilities": ["bounded_parameter_strategy_extension"],
      "auto_promote": true,
      "requires_regression_cases": true,
      "minimum_confirmed_cases": 3
    }
  ],
  "cycle": {
    "max_plugins_per_failure": 6,
    "stop_after_promotion": true,
    "runtime_patch_auto_promotion": false
  }
}
