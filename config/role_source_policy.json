    "native_binding_support_roots": ["binding", "bindings", "doc", "docs", "ext_tools", "third_party", "vendor", "vendored"],
    "foreign_monorepo_min_files": 500,
    "foreign_monorepo_files_per_python": 8,
    "foreign_language_source_extensions": [".ex", ".exs", ".go", ".java", ".kt", ".ml", ".mli", ".rb", ".scala", ".swift", ".v"],
    "deployment_template_markers": ["deployment template", "project template", "template aims to", "baseline extracted"],
    "deployment_template_infra_files": ["captain-definition", "docker-compose.yml", "dockerfile", "stack.yml"],
    "incidental_python_automation_max_files": 20,
    "incidental_python_automation_roots": ["ansible", "contrib", "inventory", "library", "playbooks", "plugins", "roles", "scripts", "tools"],
    "incidental_python_context_roots": ["integration", "integrations"],
    "curriculum_exercise_path_parts": ["exercise", "exercises", "exercice", "exercices"],
    "incidental_polyglot_python_max_files": 8,
    "incidental_polyglot_non_python_min_files": 50,
    "path_score_roots": ["src", "lib", "package", "packages"],
    "path_score_root_bonus": 35,
    "path_score_project_name_bonus": 35,
    "path_score_parent_name_bonus": 45,
    "path_score_project_prefix_bonus": 25,
