    "path_score_root_bonus": 35,
    "path_score_project_name_bonus": 35,
    "path_score_parent_name_bonus": 45,
    "path_score_project_prefix_bonus": 25,
    "path_score_core_alias_bonus": 22,
    "named_package_min_score": 35,
