    "frontend_package_min_score": 70,
    "application_package_min_python_files": 40,
    "application_package_min_score": 45,
    "standalone_project_min_python_files": 40,
    "standalone_project_min_score": 45,
    "standalone_project_max_js_per_python_percent": 25,
    "monorepo_python_roots": ["py", "python", "python_modules"],
    "monorepo_min_python_files": 40,
    "monorepo_min_score": 80,
    "aliased_core_suffixes": ["_core", "_sdk"],
    "aliased_core_top_n": 5,
    "aliased_core_min_python_files": 40,
    "aliased_core_min_score": 35,
    "aliased_core_max_gap": 8,
    "library_root_min_score": 40,
