{
  "schema_version": "role_source_policy.v1",
  "status": "active",
  "implementation_target_policy": {
    "implementation_evidence_scope_limit": 32,
    "source_snippet_max_chars": 4000,
    "context_only_path_tokens": [
      "/.github/",
      "/bench/",
      "/benchmarks/",
      "/backup/",
      "/ci_tools/",
      "/doc/",
      "/docs/",
      "/docs_src/",
      "docs_src/",
      "/downstream/",
      "/examples/",
      "/end_to_end_tests/",
      "end_to_end_tests/",
      "/samples/",
      "_samples/",
      "/failures-to-investigate/",
      "/integration/",
      "/integration-test/",
      "/integration_test/",
      "/integration_tests/",
      "/_static_dependencies/",
      "/_vendor/",
      "/third_party/",
      "/vendor/",
      "/vendored/",
      "/packaging/pep517_backend/",
      "/profiling/",
      "/scenarios/example_fixture/",
      "/scripts/",
      "/tasks/",
      "/test/",
      "/tests/",
      "/tools/",
      "/__pycache__/"
    ],
    "context_only_file_tokens": [
      "benchmark.py",
      "bench.py",
      "conftest.py",
      "example_",
      "_bench.py",
      "_benchmark.py",
      "noxfile.py",
      "setup.py",
      "gunicorn_conf.py",
      "tasks.py",
      "testclient.py",
      "testing.py"
      ,"_pytest.py"
    ],
    "fallback_product_path_tokens": ["/scripts/"],
    "module_script_boundary": {
      "enabled": true,
      "allowed_source_health": ["clean"],
      "allowed_project_shapes": ["single_project"],
      "allow_parser_compatibility_noise": true,
      "max_entrypoint_candidates": 2,
      "candidate_limit": 2,
      "required_blocker": "no_safe_python_candidate",
      "candidate_kind": "module_script_process_boundary",
      "reason": "clean executable Python entrypoint requires a bounded main/run extraction contract",
      "network_imports": ["aiohttp", "boto3", "github", "google", "grpc", "httpx", "openai", "requests", "urllib"],
      "secret_env_markers": ["credential", "key", "password", "secret", "token"],
      "path_argument_markers": ["dest", "file", "out", "path", "source", "src"],
      "json_output_calls": ["json.dump", "json.dumps"]
    },
    "blocked_status": "blocked_no_safe_candidate",
    "blocked_by": [
      "no_safe_source_specific_candidate",
      "context_only_implementation_target"
    ],
    "selection_reason": "selected source is allowed as evidence context only; Implementer requires a writable runtime target"
  },
  "scope_selection_policy": {
    "syntax_fixture_path_parts": ["fixtures", "fixture", "testdata"],
    "syntax_fixture_roots": ["doc", "docs", "example", "examples", "test", "tests", "testing"],
    "syntax_fixture_data_roots": ["test", "tests", "testing"],
    "syntax_fixture_data_path_tokens": ["/data/", "/eval_files/"],
    "syntax_fixture_doc_path_tokens": ["/docs/"],
    "syntax_fixture_doc_required_any": ["example", "/samples/"],
    "syntax_fixture_file_tokens": ["_template.py", "template.py"],
    "quarantinable_production_syntax_error_max": 3,
    "quarantine_min_safe_candidates": 3,
    "preferred_root_bonus": 40,
    "preferred_roots": ["src", "lib"],
    "core_root_bonus": 25,
    "core_root_tokens": ["core", "runtime", "engine", "sdk"],
    "support_root_penalty": 15,
    "support_roots": ["cli", "client", "dev"],
    "support_root_suffixes": ["-ctl", "_ctl"],
    "disfavored_root_penalty": 80,
    "disfavored_roots": [
      ".github",
      "bench",
      "benches",
      "benchmark",
      "benchmarks",
      "backup",
      "ci",
      "doc",
      "docs",
      "example",
      "examples",
      "script",
      "scripts",
      "test",
      "tests"
    ],
    "soft_disfavored_root_penalty": 25,
    "soft_disfavored_roots": ["devel", "devel-common", "dev", "gallery", "galleries", "tools", "utils"],
    "candidate_excluded_dirs": [".git", ".hg", ".pytest_cache", ".venv", "__pycache__", "node_modules", "site-packages", "venv"],
    "candidate_noise_parts": ["archives", "backup", "generated", "runs", "scratch", "source_project", "test_workspace", "tmp"],
    "candidate_noise_suffixes": [".bin", ".db", ".jsonl", ".log", ".pickle", ".pkl", ".sqlite", ".zip"],
    "manifest_names": ["package.json", "pyproject.toml", "readme.md", "requirements.txt", "setup.py"],
    "python_product_manifest_names": ["pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", "pipfile"],
    "python_product_entrypoints": ["main.py", "app.py", "manage.py", "train.py"],
    "cpp_runtime_core_min_files": 10,
    "native_monorepo_min_files": 500,
    "native_monorepo_files_per_python": 5,
    "native_binding_core_min_files": 20,
