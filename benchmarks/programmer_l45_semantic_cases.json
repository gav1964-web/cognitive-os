      "source": "import re\n\ndef map_versions_to_parameter_files(parameter_files):\n    result = {}\n    pattern = re.compile(r'^.*openff_unconstrained-(\\d+\\.\\d+).offxml.*$', re.IGNORECASE)\n    for parameter_file in parameter_files:\n        match = pattern.match(parameter_file)\n        if match:\n            result[match.group(1)] = parameter_file\n    return result\n",
      "examples": [
